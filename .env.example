# Example environment variables for local development
# Do NOT commit your real credentials. Keep secrets out of source control.

# Google Drive folder ID (e.g. from URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Google service account key JSON. For local development, put the full JSON
# on a single line or set this variable from the file contents.
# Example (single-line JSON):
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",...}'
# Recommended: set this variable from the JSON file contents in PowerShell:
# $env:GOOGLE_SERVICE_ACCOUNT_KEY = Get-Content .\service-account.json -Raw
GOOGLE_SERVICE_ACCOUNT_KEY=''
